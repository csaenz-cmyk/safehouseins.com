# Cloudflare Pages / Netlify redirect table.
#
# One canonical shape per page. The site grew .html pages first and directory
# URLs later, so several pages answer on both — two URLs with identical content
# split their own signals and neither one wins. The directory form is canonical
# because that is what the 189 generated pages already use.
#
# 301, not 302: these are permanent and a temporary redirect asks a crawler to
# keep the old URL in its index.

# --- legal pages that exist in both shapes ---------------------------------
/privacy.html            /privacy/            301
/sms-terms.html          /sms-terms/          301

# --- older .html routes to their final names -------------------------------
/auto.html                 /auto-insurance         301
/auto-insurance.html       /auto-insurance         301
/home-insurance.html       /home-insurance         301
/commercial.html           /commercial-insurance   301
/commercial-insurance.html /commercial-insurance   301
/about.html              /about               301
/contact.html            /contact             301
/careers.html            /careers             301
/quote.html              /quote               301

# --- development work: never a public landing page -------------------------
# Kept in the repository, kept out of production. A 404 would be honest but a
# redirect home is kinder to anyone who has an old preview link.
/index-b.html            /                    301
/jerry-1.html            /                    301
/jerry-2.html            /                    301
/option-*                /                    301

# --- pages the old site had, so inbound links and printed material keep working
/pay.html                /pay/                301
/payment                 /pay/                301
/make-a-payment          /pay/                301

# /claims — the claim reporting page. Same shape as the payment redirects: the
# words people actually type, and the .html a linker might guess.
/claim                   /claims/                301
/claims.html             /claims/                301
/file-a-claim            /claims/                301
/report-a-claim          /claims/                301
/claims/guide.html       /claims/guide/          301

# /id-card and /lienholder — document requests. Same shape as the others.
/idcard                  /id-card/               301
/id-cards                /id-card/                301
/insurance-card          /id-card/                301
/proof-of-insurance      /id-card/                301
/declarations-page       /id-card/                301
/dec-page                /id-card/                301
/lienholders             /lienholder/             301
/loss-payee              /lienholder/             301
/lender                  /lienholder/             301
/evidence-of-insurance   /lienholder/             301
