# Cache and security headers.
#
# Conservative on purpose: nothing here can break the quote form's POST to the
# AMS bridge or the outbound links on the payments page, because a header that
# breaks a lead is worse than a header that was never set.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Hashed or effectively immutable assets. Images and fonts here are replaced by
# a new filename when they change, so a year is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shared stylesheet keeps its name across releases, so it gets a short
# cache with revalidation instead of a year — otherwise a design fix would take
# a year to reach anybody who had already visited.
/assets/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

# HTML is regenerated by the build. Always revalidate so a corrected city page
# or a fixed price disclaimer is never served stale.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
